# Configuração do SetupSO (copie para .env e ajuste)

# Chave secreta para assinar tokens JWT (use uma string longa e aleatória em produção)
JWT_SECRET=troque-por-uma-chave-secreta-longa-e-aleatoria

# Porta do servidor HTTP
PORT=3000

# Caminho do banco de dados SQLite
DB_PATH=./data/setupso.db

# Tempo de expiração do token JWT (ex: 8h, 24h, 7d)
JWT_EXPIRES_IN=8h
